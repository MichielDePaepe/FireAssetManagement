# Copy to .env. Development defaults are for local/LAN use only.
PROJECT_NAME=web-project-starter
APP_TITLE=Web Project Starter
PYTHON_PACKAGE=config

FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://api:8000
APP_PORT=8080
FLOWER_PORT=5555
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=web_project_starter
POSTGRES_USER=web_project_starter
POSTGRES_PASSWORD=change-me-for-production
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=5
CELERY_TASK_SOFT_TIME_LIMIT=75
CELERY_TASK_TIME_LIMIT=90

DJANGO_SECRET_KEY=local-development-only-change-this-before-production
DJANGO_DEBUG=true
DJANGO_SECURE_COOKIES=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Update trusted origins if you change a browser-facing port or host.

# Local development demo account only. Change both for any shared environment.
DEMO_USERNAME=starter
DEMO_PASSWORD=starter-dev-only

# Optional production Flower access (used only with the monitoring profile).
FLOWER_USER=
FLOWER_PASSWORD=

# Optional TLS termination. The default production path is plain HTTP on a trusted LAN.
HTTPS_DOMAIN=
ACME_EMAIL=
