# Copy to .env. Development defaults are for local/LAN use only.
PROJECT_NAME=web-project-starter
APP_TITLE=Web Project Starter
PYTHON_PACKAGE=config

FRONTEND_PORT=5174
VITE_API_PROXY_TARGET=http://api:8000
APP_PORT=8081
FLOWER_PORT=5556
HTTP_PORT=8082
HTTPS_PORT=8444
# Use a distinct set of host ports in each checkout running on the same computer.

POSTGRES_DB=web_project_starter
POSTGRES_USER=web_project_starter
POSTGRES_PASSWORD=change-me-for-production
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=5
CELERY_TASK_SOFT_TIME_LIMIT=75
CELERY_TASK_TIME_LIMIT=90

DJANGO_SECRET_KEY=local-development-only-change-this-before-production
DJANGO_DEBUG=true
DJANGO_SECURE_COOKIES=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081
# Update trusted origins if you change a browser-facing port or host.

# Fireplan credentials are encrypted in PostgreSQL with this separate Fernet key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIREPLAN_BASE_URL=https://fireplan.firebru2k8.local
FIREPLAN_CREDENTIAL_KEY=
# Keep HTTPS hostname validation enabled unless an internal alias has a certificate
# issued for its canonical hostname. Certificate authority validation always remains on.
FIREPLAN_ALLOW_CERTIFICATE_HOSTNAME_MISMATCH=false

# CityGIS resources service; Fireplan credentials above are reused for its login.
CITYGIS_RESOURCES_BASE_URL=http://resourcesoff.firebru2k8.local

# Local development demo account only. Change both for any shared environment.
DEMO_USERNAME=starter
DEMO_PASSWORD=starter-dev-only

# Optional production Flower access (used only with the monitoring profile).
FLOWER_USER=
FLOWER_PASSWORD=

# Optional TLS termination. The default production path is plain HTTP on a trusted LAN.
HTTPS_DOMAIN=
ACME_EMAIL=
