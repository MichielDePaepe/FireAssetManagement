# Production on a trusted local network (HTTP, no TLS certificates required).
PROJECT_NAME=web-project-starter
APP_TITLE=Web Project Starter
PYTHON_PACKAGE=config
APP_PORT=8081
FLOWER_PORT=5556
HTTP_PORT=8082
HTTPS_PORT=8444

POSTGRES_DB=web_project_starter
POSTGRES_USER=web_project_starter
POSTGRES_PASSWORD=replace-with-a-unique-password-at-least-16-characters

DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=false
DJANGO_SECURE_COOKIES=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,server-name-on-your-lan,api
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://server-name-on-your-lan:8081
# Update trusted origins if you change APP_PORT or the hostname used by browsers.
FIREPLAN_BASE_URL=https://fireplan.firebru2k8.local
FIREPLAN_CREDENTIAL_KEY=generate-a-unique-fernet-key-for-this-deployment
FIREPLAN_ALLOW_CERTIFICATE_HOSTNAME_MISMATCH=false

# CityGIS resources service; Fireplan credentials above are reused for its login.
CITYGIS_RESOURCES_BASE_URL=http://resourcesoff.firebru2k8.local
DEMO_USERNAME=
DEMO_PASSWORD=

# Set non-empty values only if starting the optional Flower monitoring profile.
FLOWER_USER=
FLOWER_PASSWORD=

# Optional Caddy HTTPS overlay. Public ACME requires DNS and reachable 80/443.
HTTPS_DOMAIN=
ACME_EMAIL=
